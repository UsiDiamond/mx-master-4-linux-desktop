Description: Lower the Qt6 minimum from 6.5 to 6.4
 Ubuntu 24.04 LTS and Debian bookworm ship Qt 6.4.2.  The overlay and config
 GUI do not use any 6.5-only API, so relaxing the find_package() floor to 6.4
 lets the package build on these stable releases.  Distributions shipping
 Qt 6.5+ are unaffected.
Author: UsiDiamond <noreply@usidiamond.dev>
Forwarded: not-needed
Last-Update: 2026-06-24
--- a/overlay/CMakeLists.txt
+++ b/overlay/CMakeLists.txt
@@ -29,7 +29,7 @@ endif()
 endif()
 
 # --- Qt6 ------------------------------------------------------------------
-find_package(Qt6 6.5 REQUIRED COMPONENTS
+find_package(Qt6 6.4 REQUIRED COMPONENTS
     Core
     Gui
     Qml
--- a/config-ui/CMakeLists.txt
+++ b/config-ui/CMakeLists.txt
@@ -32,14 +32,14 @@
 # QuickControls2 gives us the Controls 2 forms; it is required for the GUI.
 # We verify it explicitly at configure time so a missing component fails loudly
 # rather than at link time.
-find_package(Qt6 6.5 REQUIRED COMPONENTS
+find_package(Qt6 6.4 REQUIRED COMPONENTS
     Core
     Gui
     Qml
     Quick
     DBus)
 
-find_package(Qt6 6.5 QUIET COMPONENTS QuickControls2)
+find_package(Qt6 6.4 QUIET COMPONENTS QuickControls2)
 if(Qt6QuickControls2_FOUND)
     message(STATUS "mx4-config: Qt6 QuickControls2 found")
 else()
