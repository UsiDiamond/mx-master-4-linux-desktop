<node>
  <interface name="org.snapdragon.MX4Daemon1">

    <method name="PlayHaptic">
      <arg name="waveform"  type="y" direction="in"/>
      <arg name="intensity" type="y" direction="in"/>
    </method>

    <method name="SetHapticLevel">
      <arg name="level" type="y" direction="in"/>
    </method>

    <signal name="ActionRingPressed">
      <arg name="cid" type="q"/>
    </signal>

  </interface>
</node>
